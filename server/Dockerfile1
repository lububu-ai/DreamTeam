FROM ubuntu

ENV TZ=Europe/Moscow
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
RUN sed -i'' 's/mirror\.yandex\.ru/ubuntu/' /etc/apt/sources.list

RUN apt-get update
RUN apt-get install --fix-missing qtbase5-dev qtchooser qt5-qmake qtbase5-dev-tools libqt5sql5 libqt5sql5-sqlite -y
RUN apt-get install --fix-missing build-essential -y

WORKDIR /root/
RUN mkdir server
WORKDIR /root/server/
COPY *.cpp /root/server/
COPY *.h /root/server/
COPY *.pro /root/server/
COPY *.db /root/server/

RUN qmake tcpServer.pro
RUN make
RUN uname -m

ENTRYPOINT ["./tcpServer"]